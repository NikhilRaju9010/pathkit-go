{{define "def"}}
<dl>
<dt>What it means</dt><dd>{{.Meaning}}</dd>
<dt>Why</dt><dd>{{.Why}}</dd>
<dt>Example</dt><dd>{{.Example}}{{if .ExampleWhere}}<br>From this run: <code>{{.ExampleWhere}}</code>: <code class="path">{{.ExampleText}}</code>{{end}}</dd>
<dt>Possible in production?</dt><dd>{{.PossibleInProduction}}</dd>
<dt>Bucket</dt><dd>{{if .Bucket}}{{.Bucket}}{{else}}(not set){{end}}</dd>
<dt>Decided by</dt><dd>{{.DecidedBy}}{{if .Confidence}}, confidence {{.Confidence}}{{end}}{{if .Custom}} (a custom label from the config){{end}}</dd>
{{- if .NotDetectedYet}}
<dt>Detection</dt><dd><strong>Not detected yet.</strong> PathKit never sets this label by itself (see LIMITATIONS.md).{{if .PersonCanSet}} A person can use it with a mark or a rule in the config.{{else}} A person cannot set it either: marks and rules may only use cannot-be-tested labels. Deal with such a path by marking it testable or untestable by its stable id, as under "What to do".{{end}}</dd>
{{- end}}
<dt>What to do</dt><dd>{{.WhatToDo}}</dd>
<dt>Paths in this run</dt><dd>{{.Count}}{{if .Uses}}: {{range $i, $u := .Uses}}{{if $i}}, {{end}}<a href="#{{$u.Anchor}}">{{$u.Text}}</a>{{end}}{{if .MoreUses}} and {{.MoreUses}} more{{end}}{{end}}</dd>
</dl>
{{- end}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-PKSCRIPTHASH'; img-src data:">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="generator" content="pathkit-go">
<title>{{.Title}}</title>
<style>
/*STYLE*/
</style>
</head>
<body>
<a class="skip" href="#main">Skip to the content</a>
<header class="top">
<h1>{{.Title}}</h1>
<p class="meta" data-meta>Generated {{.Generated}} · {{.Folder}} · {{.ConfigNote}} · PathKit {{.Version}}</p>
</header>
<div class="bar">
<div class="barin">
<nav aria-label="Sections">
<a href="#summary">Summary</a>
<a href="#workflows">Workflows</a>
<a href="#unread">Could not read ({{len .Unread}})</a>
{{- if .CallOutcomes}}
<a href="#call-outcomes">Call outcomes ({{len .CallOutcomes}})</a>
{{- end}}
{{- if .LoopRounds}}
<a href="#loop-rounds">Loop rounds ({{len .LoopRounds}})</a>
{{- end}}
{{- if .Handlers}}
<a href="#handlers">Handlers ({{len .Handlers}})</a>
{{- end}}
{{- if .Groups}}
<a href="#groups">Missed paths ({{.GroupsTotal}} groups)</a>
{{- end}}
<a href="#paths">Paths</a>
{{- if .Glossary}}
<a href="#definitions">Glossary</a>
<a href="#audit">Detector audit ({{len .Glossary.Audit}})</a>
{{- end}}
</nav>
<div class="search" hidden>
<label class="sr" for="q">Search paths by id or text</label>
<input id="q" type="search" placeholder="Search paths (id or text)" autocomplete="off">
</div>
</div>
</div>
<main id="main">
{{- with .CapHeadline}}
<div class="cap-warning" role="alert"><strong>{{.}}</strong>{{range $.CapAdvice}}<br>{{.}}{{end}}</div>
{{- end}}

<section id="summary" aria-labelledby="h-summary">
<h2 id="h-summary">Summary</h2>
{{- if .Measured}}
{{- if .HeadlineLines}}
{{- range .HeadlineLines}}
<p class="total headline">{{.}}</p>
{{- end}}
{{- else}}
<p class="total" data-total-paths="{{.TotalPaths}}" data-total-covered="{{.TotalCovered}}">{{.TotalLine}}</p>
<p class="branches">{{.BranchesLine}}</p>
{{- end}}
{{- end}}
<div class="cards">
{{- range .Cards}}
<div class="stat" data-card="{{.Key}}" data-covered="{{.Covered}}" data-total="{{.Total}}">
<div class="k">{{.Title}}</div>
<div class="v">{{.Value}}</div>
<div class="s">{{.Sub}}</div>
</div>
{{- end}}
</div>
<p class="explain">{{.Explain}}</p>
{{- if .Buckets}}
<h3>Paths by bucket</h3>
<div class="stack" role="img" aria-label="Paths by bucket">
{{- range .Buckets}}{{if .Paths}}<span class="bk-{{.Key}}" style="width:{{printf "%.3f" .Width}}%"></span>{{end}}{{end}}
</div>
<ul class="legend">
{{- range .Buckets}}
<li data-bucket="{{.Key}}" data-paths="{{.Paths}}" data-covered="{{.Covered}}"><span class="sw b-{{.Key}}"></span>{{.Name}}: <strong>{{.Paths}}</strong></li>
{{- end}}
</ul>
{{- end}}
{{- with .ClassLines}}
<details class="plain"><summary>Classification details (the same lines as the text report)</summary>
<pre class="classification">{{range .}}{{.}}
{{end}}</pre>
</details>
{{- end}}
{{- if .Panel}}
<div class="assumptions" data-assumptions="{{len .Panel}}">
<h3>Assumptions the claims rest on</h3>
<ul>
{{- range .Panel}}
<li data-assumption="{{.Name}}" data-on="{{.On}}"><strong>{{.Name}}</strong>: {{.Status}}; {{.Claims}}. <a href="#def-{{.Name}}">What it means</a></li>
{{- end}}
</ul>
</div>
{{- end}}
{{- with .FailUnder}}
<p class="fail-under" data-fail-under-passed="{{.Passed}}">{{.Text}}</p>
{{- end}}
</section>

<section id="workflows" aria-labelledby="h-workflows">
<h2 id="h-workflows">Workflows</h2>
{{- if .Workflows}}
<div class="tablebox">
<table class="over">
<thead><tr><th scope="col">Workflow</th><th scope="col">File</th>{{if .Measured}}<th scope="col">Priority</th><th scope="col">Coverage</th><th scope="col">Missed</th>{{end}}<th scope="col">Paths</th></tr></thead>
<tbody>
{{- range $i, $w := .Workflows}}
<tr data-overview="{{$w.Name}}">
<td data-label="Workflow"><a href="#wf-{{$i}}">{{$w.Name}}</a>{{if $w.AddedByConfig}} <span class="added">added by config</span>{{end}}</td>
<td data-label="File" class="file">{{$w.File}}</td>
{{- if $.Measured}}
<td data-label="Priority">{{if $w.Priority}}<span class="badge prio-{{$w.Priority}}">{{$w.Priority}}</span>{{else}}no paths{{end}}</td>
<td data-label="Coverage"><span class="bar-mini" aria-hidden="true"><i style="width:{{printf "%.1f" $w.Width}}%"></i></span> {{$w.Covered}} of {{$w.Total}} · {{$w.Pct}}</td>
<td data-label="Missed">{{$w.Missed}}</td>
{{- end}}
<td data-label="Paths">{{$w.Total}}{{if $w.Truncated}}+ <span class="truncated">truncated</span>{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p class="note">No workflows in scope.</p>
{{- end}}
</section>

<section id="unread" aria-labelledby="h-unread" data-unread="{{len .Unread}}">
<h2 id="h-unread">What PathKit could not fully read</h2>
{{- if .Unread}}
<p class="note">Calls PathKit did not follow into, and places it cut off. For each, the last column says what it did instead.</p>
<div class="tablebox">
<table class="over">
<caption class="sr">Places PathKit could not fully read</caption>
<thead><tr><th scope="col">Where</th><th scope="col">Workflow</th><th scope="col">Kind</th><th scope="col">Code</th><th scope="col">What PathKit did</th></tr></thead>
<tbody>
{{- range .Unread}}
<tr data-unread-kind="{{.Kind}}">
<td data-label="Where" class="file">{{.Where}}</td>
<td data-label="Workflow">{{.Workflow}}</td>
<td data-label="Kind">{{.Kind}}</td>
<td data-label="Code"><code>{{.Call}}</code></td>
<td data-label="What PathKit did">{{.Effect}}{{if .Suggestion}} To tell PathKit about it, add <code>{{.Suggestion}}</code> to <code>classification.activity_wrappers</code>.{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p class="note">{{.UnreadNone}}</p>
{{- end}}
</section>

{{- if .CallOutcomes}}
<section id="call-outcomes" aria-labelledby="h-call-outcomes" data-call-outcomes="{{len .CallOutcomes}}">
<h2 id="h-call-outcomes">Call outcomes</h2>
<p class="note">Every activity, child workflow and Nexus call whose result the code checks: the outcomes it can have, and whether a recorded test saw each. A failure the code tells apart (a timeout, a cancellation) is listed under the call.</p>
<div class="tablebox">
<table class="over">
<caption class="sr">Outcomes of the checked calls</caption>
<thead><tr><th scope="col">Call</th><th scope="col">Workflow</th><th scope="col">Where</th><th scope="col">Outcomes</th></tr></thead>
<tbody>
{{- range .CallOutcomes}}
<tr data-call-gap="{{.Gap}}">
<td data-label="Call">{{.Call}}</td>
<td data-label="Workflow">{{.Workflow}}</td>
<td data-label="Where" class="file">{{.Where}}</td>
<td data-label="Outcomes">{{range $i, $o := .Outcomes}}{{if $i}}, {{end}}{{$o.Name}} {{if $o.Seen}}seen{{else}}<strong>not seen</strong>{{end}}{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}

{{- if .LoopRounds}}
<section id="loop-rounds" aria-labelledby="h-loop-rounds" data-loop-rounds="{{len .LoopRounds}}">
<h2 id="h-loop-rounds">Loop rounds</h2>
<p class="note">A path goes into a loop once, but a run goes round as often as the data says. For every loop: whether a recorded test ran it with no round, with one, and with two or more. A loop no test ran with two or more rounds is a gap.</p>
<div class="tablebox">
<table class="over">
<caption class="sr">Rounds each loop ran in the recorded tests</caption>
<thead><tr><th scope="col">Loop</th><th scope="col">Workflow</th><th scope="col">Where</th><th scope="col">0 rounds</th><th scope="col">1 round</th><th scope="col">2+ rounds</th></tr></thead>
<tbody>
{{- range .LoopRounds}}
<tr data-loop-gap="{{.Gap}}">
<td data-label="Loop"><code>{{.Loop}}</code></td>
<td data-label="Workflow">{{.Workflow}}</td>
<td data-label="Where" class="file">{{.Where}}</td>
{{- range .Rounds}}
<td data-label="{{.Bucket}}">{{if eq .State "not seen"}}<strong>not seen</strong>{{else}}{{.State}}{{end}}</td>
{{- end}}
</tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}

{{- if .Handlers}}
<section id="handlers" aria-labelledby="h-handlers" data-handlers="{{len .Handlers}}">
<h2 id="h-handlers">Handlers</h2>
<p class="note">Signals, queries, updates and update validators the workflows register. "Exercised" says whether a recorded test ran it; "not recorded" means a trace cannot show it. The code of an update handler or validator is mapped like a small workflow, so its branches are counted.</p>
<div class="tablebox">
<table class="over">
<caption class="sr">Handlers the workflows register</caption>
<thead><tr><th scope="col">Handler</th><th scope="col">Kind</th><th scope="col">Workflow</th><th scope="col">Registered at</th><th scope="col">Exercised</th><th scope="col">Branches taken</th></tr></thead>
<tbody>
{{- range .Handlers}}
<tr data-handler-gap="{{.Gap}}">
<td data-label="Handler">{{.Name}}</td>
<td data-label="Kind">{{.Kind}}</td>
<td data-label="Workflow">{{.Owner}}</td>
<td data-label="Registered at" class="file">{{.Where}}</td>
<td data-label="Exercised">{{.Exercised}}</td>
<td data-label="Branches taken">{{.Branches}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}

{{- if .Groups}}
<section id="groups" aria-labelledby="h-groups" data-groups="{{.GroupsTotal}}">
<h2 id="h-groups">Missed paths by first untested step</h2>
<p class="note">Testable paths with no test: {{.GroupsPaths}}. A group is the paths that leave the road the tests walked at the same step, so one new test that takes that step usually covers several of them. Biggest groups first. A workflow with more paths than the list holds counts only its listed paths.</p>
<div class="tablebox">
<table class="over">
<caption class="sr">Missed paths grouped by the first step no test took</caption>
<thead><tr><th scope="col">Paths</th><th scope="col">Workflow</th><th scope="col">First untested step</th><th scope="col">Where</th><th scope="col">How to cover it</th></tr></thead>
<tbody>
{{- range .Groups}}
<tr>
<td data-label="Paths">{{.Paths}}</td>
<td data-label="Workflow">{{.Workflow}}</td>
<td data-label="First untested step"><code>{{.Step}}</code><br><span class="note">{{.After}}</span></td>
<td data-label="Where" class="file">{{.Where}}</td>
<td data-label="How to cover it">{{.Hint}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{- if .GroupsMore}}
<p class="note">... and {{.GroupsMore}} more groups (<code>pathkit report --groups --json</code> lists them).</p>
{{- end}}
</section>
{{- end}}

<section id="paths" aria-labelledby="h-paths">
<h2 id="h-paths">Paths</h2>
{{- if not .Measured}}
<p class="note">Not measured. This page comes from <code>pathkit analyze</code>, which maps the paths but doesn't read test runs. Run <code>pathkit test</code>, then <code>pathkit report --html</code>, for coverage.</p>
{{- end}}
<p class="jsnote" role="note">The path tables need JavaScript. The summary, the workflow overview and the glossary on this page work without it.</p>
{{- range $i, $w := .Workflows}}
<details class="wf" id="wf-{{$i}}"{{if $w.Open}} open{{end}} data-workflow="{{$w.Name}}" data-covered="{{$w.Covered}}" data-paths="{{$w.Total}}" data-priority="{{$w.Priority}}" data-truncated="{{$w.Truncated}}">
<summary><h3>{{$w.Name}}</h3>{{if $w.AddedByConfig}}<span class="added">added by config</span>{{end}}{{if $w.Priority}}<span class="badge prio-{{$w.Priority}}">{{$w.Priority}}</span>{{end}}{{if $.Measured}}<span class="bar-mini" aria-hidden="true"><i style="width:{{printf "%.1f" $w.Width}}%"></i></span><span>{{$w.Covered}} of {{$w.Total}} covered</span>{{else}}<span>{{$w.Total}} paths</span>{{end}}<span class="match" id="match-{{$i}}"></span></summary>
<div class="wbody">
<p class="file">{{$w.File}}</p>
<p class="stats">{{if $.Measured}}{{$w.Stats}}{{else}}{{$w.TotalPathsLine}}{{end}}{{if $w.Truncated}} <span class="truncated">truncated</span>{{end}}</p>
{{- if $w.Stages}}
<div class="stages" data-stages="{{$i}}">
<h4>Stages</h4>
<p class="note">{{$w.ExactLine}}{{if $w.PrunedLine}} {{$w.PrunedLine}}.{{end}} A stage is a stretch of the workflow between two decisions that every path goes through, so its paths can be counted and covered one stage at a time.</p>
<div class="tablebox">
<table class="summary-table">
<caption>Stages of {{$w.Name}}</caption>
<thead><tr><th scope="col">Stage</th><th scope="col">Paths</th><th scope="col">Covered</th><th scope="col">%</th><th scope="col">Branches</th><th scope="col">Note</th></tr></thead>
<tbody>
{{- range $w.Stages}}
<tr><td>{{.Number}}</td><td>{{.Paths}}</td><td>{{.Covered}}</td><td>{{.Pct}}</td><td>{{.Branches}}</td><td>{{.Note}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
<div class="sg" data-sg="{{$i}}"></div>
</div>
{{- end}}
{{- if $w.Helpers}}
<div class="helpers" data-helpers="{{$i}}">
<h4>Helpers</h4>
<p class="note">{{$w.HelpersNote}}.</p>
<div class="tablebox">
<table class="summary-table">
<caption>Helpers of {{$w.Name}}</caption>
<thead><tr><th scope="col">Helper</th><th scope="col">Where</th><th scope="col">Branches taken</th><th scope="col">Called at</th></tr></thead>
<tbody>
{{- range $w.Helpers}}
<tr><td>{{.Name}}</td><td class="file">{{.Where}}</td><td>{{.Branches}}</td><td>{{.Sites}} {{if eq .Sites "1"}}site{{else}}sites{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
</div>
{{- end}}
<div class="pt" data-pt="{{$i}}"></div>
</div>
</details>
{{- end}}
</section>

{{- if .Measured}}
<section class="run" aria-labelledby="h-run">
<h2 id="h-run">Run details</h2>
{{- with .Traces}}
<p class="traces" data-read="{{.Read}}" data-counted="{{.Counted}}" data-unmatched="{{.Unmatched}}" data-stale="{{.Stale}}" data-incomplete="{{.Incomplete}}" data-excluded-traces="{{.Excluded}}" data-unknown="{{.Unknown}}" data-unreadable="{{.Unreadable}}" data-other="{{.Other}}">{{$.TracesLine}}</p>
{{- end}}
<div class="excluded" data-excluded="{{len .Excluded}}">
<h3>{{.ExcludedLine}}</h3>
{{- if .Excluded}}
<ul>
{{- range .Excluded}}
<li data-excluded-workflow="{{.Name}}"><code>{{.Name}}</code>: <span class="reason">{{.Reason}}</span></li>
{{- end}}
</ul>
{{- end}}
</div>
<div class="trend">
<h3>Trend (last {{len .Trend}} report {{if eq (len .Trend) 1}}run{{else}}runs{{end}})</h3>
<ol>
{{- range .Trend}}
<li data-trend-covered="{{.Covered}}" data-trend-paths="{{.Paths}}">{{.Time}} · {{.Covered}}/{{.Paths}} · {{.Pct}} <meter min="0" max="100" value="{{.Percent}}">{{.Pct}}</meter>{{with .ScopeChanged}} <span class="scope-changed">{{.}}</span>{{end}}</li>
{{- end}}
</ol>
</div>
</section>
{{- else}}
<section class="excluded" data-excluded="{{len .Excluded}}" aria-labelledby="h-excl">
<h2 id="h-excl">{{.ExcludedLine}}</h2>
{{- if .Excluded}}
<ul>
{{- range .Excluded}}
<li data-excluded-workflow="{{.Name}}"><code>{{.Name}}</code>: <span class="reason">{{.Reason}}</span></li>
{{- end}}
</ul>
{{- end}}
</section>
{{- end}}

{{- with .Glossary}}

<section class="definitions" id="definitions" data-definitions-version="{{.Version}}" aria-labelledby="h-def">
<h2 id="h-def">Glossary</h2>
<p class="note">Click a label anywhere on this page to jump to its definition.</p>
<dl class="terms" id="terms">
{{- range .Terms}}
<dt>{{.Name}}</dt><dd>{{.Meaning}}</dd>
{{- end}}
</dl>
{{- if .Summary}}
<div class="tablebox">
<table class="summary-table">
<caption>Labels used in this run</caption>
<thead><tr><th scope="col">Label</th><th scope="col">Bucket</th><th scope="col">Paths</th><th scope="col">Automatic</th><th scope="col">Manual</th><th scope="col">Decided by</th></tr></thead>
<tbody>
{{- range .Summary}}
<tr><td><a class="label" href="#def-{{.Label}}">{{.Label}}</a></td><td>{{.Bucket}}</td><td>{{.Count}}</td><td>{{.Auto}}</td><td>{{.Manual}}</td><td>{{.DecidedBy}}{{if .NotDetectedYet}} (not detected yet){{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p class="note">No path in this run has a label.</p>
{{- end}}
{{- range .Used}}
<article class="def" id="def-{{.Name}}" data-label="{{.Name}}" data-count="{{.Count}}">
<h3>{{.Name}}</h3>
{{template "def" .}}
</article>
{{- end}}
{{- if .Unused}}
<details class="unused">
<summary>Labels not used in this run ({{len .Unused}})</summary>
{{- range .Unused}}
<article class="def" id="def-{{.Name}}" data-label="{{.Name}}" data-count="0">
<h3>{{.Name}}</h3>
{{template "def" .}}
</article>
{{- end}}
</details>
{{- end}}
{{- if .Groups}}
<h3 id="unknown-input-groups">Paths by type switch (unknown-input-type)</h3>
<div class="tablebox">
<table class="summary-table">
<thead><tr><th scope="col">Type switch</th><th scope="col">Paths</th></tr></thead>
<tbody>
{{- range .Groups}}
<tr><td><code>{{.Switch}}</code></td><td>{{.Paths}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}
{{- range .Assumptions}}
<article class="def" id="def-{{.Name}}" data-assumption="{{.Name}}">
<h3>Assumption: {{.Name}}</h3>
<dl>
<dt>Status</dt><dd>{{.Status}}</dd>
<dt>Claims resting on it</dt><dd>{{.Claims}}</dd>
<dt>What it means</dt><dd>{{.Meaning}}</dd>
<dt>Why</dt><dd>{{.Why}}</dd>
<dt>What to do</dt><dd>{{.WhatToDo}}</dd>
</dl>
</article>
{{- end}}
<p class="footer">Definitions version {{.Version}}</p>
</section>

<section class="audit" id="audit" data-audit="{{len .Audit}}" aria-labelledby="h-audit">
<h2 id="h-audit">Detector audit</h2>
<p>Every path a <strong>detector</strong> (not a rule and not a person) marked cannot-be-tested in this run, with the label and the reason. Spot-check these against the code: a wrong "impossible" hides a real gap. The path number opens the path in its workflow.</p>
{{- if .Audit}}
<div id="audit-root"></div>
<p class="jsnote" role="note">The detector audit table needs JavaScript. It lists {{len .Audit}} paths.</p>
{{- else}}
<p class="note">No path was marked cannot-be-tested by a detector in this run.</p>
{{- end}}
{{- if .AuditOther}}
<p class="note">{{.AuditOther}} more {{if eq .AuditOther 1}}path was{{else}}paths were{{end}} sent by a detector to needs-review or needs-special-test (not counted above).</p>
{{- end}}
</section>
{{- end}}
</main>
<script id="pk-data" type="application/json">{{.Data}}</script>
<script id="pk-code">
/*SCRIPT*/
</script>
</body>
</html>
